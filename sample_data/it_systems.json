{
  "database_schema": {
    "users": {
      "user_id": {
        "description": "Unique identifier for system users",
        "type": "VARCHAR(50)",
        "primary_key": true,
        "example": "USR-123456"
      },
      "username": {
        "description": "Login name for user authentication",
        "type": "VARCHAR(100)",
        "unique": true,
        "example": "john.doe@company.com"
      },
      "created_date": {
        "description": "Timestamp when user account was created",
        "type": "TIMESTAMP",
        "example": "2024-01-15 10:30:00"
      },
      "last_login": {
        "description": "Most recent login timestamp",
        "type": "TIMESTAMP",
        "example": "2024-10-20 08:15:00"
      },
      "status": {
        "description": "Account status indicator",
        "type": "VARCHAR(20)",
        "values": ["active", "inactive", "suspended"],
        "example": "active"
      },
      "role_id": {
        "description": "Foreign key to user role",
        "type": "INT",
        "example": "3"
      }
    },
    "sessions": {
      "session_id": {
        "description": "Unique session identifier",
        "type": "VARCHAR(100)",
        "primary_key": true,
        "example": "SESS-789012"
      },
      "user_id": {
        "description": "Reference to user who owns session",
        "type": "VARCHAR(50)",
        "foreign_key": "users.user_id",
        "example": "USR-123456"
      },
      "session_start": {
        "description": "When session was initiated",
        "type": "TIMESTAMP",
        "example": "2024-10-20 08:00:00"
      },
      "session_end": {
        "description": "When session was terminated",
        "type": "TIMESTAMP",
        "nullable": true,
        "example": "2024-10-20 09:30:00"
      },
      "ip_address": {
        "description": "IP address of user session",
        "type": "VARCHAR(45)",
        "example": "192.168.1.100"
      },
      "duration_minutes": {
        "description": "Total session duration in minutes",
        "type": "INT",
        "calculated": true,
        "formula": "TIMESTAMPDIFF(MINUTE, session_start, session_end)",
        "example": "90"
      }
    },
    "system_metrics": {
      "metric_id": {
        "description": "Unique metric identifier",
        "type": "INT",
        "primary_key": true,
        "auto_increment": true
      },
      "metric_timestamp": {
        "description": "Time when metric was captured",
        "type": "TIMESTAMP",
        "example": "2024-10-20 10:00:00"
      },
      "cpu_usage_percent": {
        "description": "CPU utilization percentage",
        "type": "DECIMAL(5,2)",
        "example": "45.67"
      },
      "memory_usage_mb": {
        "description": "Memory usage in megabytes",
        "type": "INT",
        "example": "4096"
      },
      "active_connections": {
        "description": "Number of active database connections",
        "type": "INT",
        "example": "125"
      },
      "response_time_ms": {
        "description": "Average response time in milliseconds",
        "type": "INT",
        "example": "250"
      },
      "uptime_hours": {
        "description": "System uptime in hours",
        "type": "DECIMAL(10,2)",
        "example": "720.50"
      }
    }
  },
  "business_metrics": {
    "daily_active_users": {
      "description": "Count of unique users who logged in during a day",
      "calculation": "COUNT(DISTINCT user_id) WHERE login_date = CURRENT_DATE",
      "unit": "count"
    },
    "average_session_duration": {
      "description": "Mean duration of user sessions",
      "calculation": "AVG(duration_minutes) FROM sessions",
      "unit": "minutes"
    },
    "system_availability": {
      "description": "Percentage of time system is operational",
      "calculation": "(total_time - downtime) / total_time * 100",
      "unit": "percentage",
      "target": "99.9"
    }
  }
}
